# Swarm v0.5.8 Configuration Template
# This file documents Swarm configuration options
# Note: Swarm v0.5.8 uses command-line flags, not TOML config files
# This template is used to generate environment variables for docker-compose

[swarm]
# Storage directory for Swarm node data
data_dir = "/app/data"

# HTTP API configuration
[swarm.api]
# HTTP API bind address (interface)
http_addr = "0.0.0.0"
# HTTP API port
http_port = 8500

# P2P network configuration
[swarm.p2p]
# P2P port (Swarm v0.5.8 uses bzzport flag)
p2p_port = 30399
# Bootstrap nodes (enode:// format)
# Example: "enode://PEER_ID@172.20.0.200:30399"
bootnodes = []

# Account and authentication
[swarm.account]
# Password for account encryption
password = "swarm-test-password"
# BZZ account address (optional, required if multiple accounts exist)
bzz_account = ""

# Logging and debugging
[swarm.logging]
# Verbosity level (0-6, higher = more verbose)
verbosity = 4
# Enable debug mode
debug = false

# Network configuration
[swarm.network]
# Network ID (Swarm v0.5.8 doesn't expose this via CLI, but it's part of the network)
network_id = ""

# Node-specific overrides (for per-node configs)
# These will be generated during startup
[node_overrides]
# node_id = "swarm-node1"
# ip_address = "172.20.0.201"
# http_port = 8500
